DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visit_tracker
CORS_ORIGINS=http://localhost:5173

# RxNorm / RxNav public REST API (no auth required). Used as a fallback when a
# medication is not found in the local reference catalog.
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST

# LLM settings for medication analysis. Fill LLM_API_KEY to enable an LLM path.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
